# CampusOS + Crew Sync AI Environment Variables
# Copy this file to .env.local and fill in your credentials when ready.

# Mode: Set to "true" to run with built-in local seed data (no Supabase/Gemini required)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (Server-side AI workflows for Crew Sync)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
